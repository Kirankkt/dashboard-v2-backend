# Copy to .env for local dev. Railway injects these as service variables in prod.
# Leave DATABASE_URL unset locally to use the SQLite fallback (./dev.db).
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=*

# Set SEED_ON_START=true on the first deploy to create the users/project on
# boot (there's no shell on Railway to run `python -m app.seed`). The seed is
# idempotent; turn this off afterwards. Credentials below are read at seed time.
SEED_ON_START=false
CONTRACTOR_NAME=Contractor
CONTRACTOR_EMAIL=contractor@example.com
CONTRACTOR_PASSWORD=change-me
CLIENT_NAME=Client
CLIENT_EMAIL=client@example.com
CLIENT_PASSWORD=change-me
